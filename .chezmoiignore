# Chezmoi Ignore File
# Files and directories to exclude from management

# Repo-level docs and metadata (no dot prefix, so without these entries
# chezmoi would deploy them to $HOME — including ~/CLAUDE.md, which AI
# tooling reads as global instructions)
README.md
CLAUDE.md
LICENSE

# Encrypted files that shouldn't be managed
*.asc
*.gpg

# OS-specific files
.DS_Store
Thumbs.db

# Editor artifacts
*.swp
*.swo
*~
.vscode/
.idea/

# Temporary files
*.tmp
*.bak
