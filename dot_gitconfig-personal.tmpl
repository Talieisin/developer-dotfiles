# Personal Identity Configuration
# Included by ~/.gitconfig for personal project directories

{{- $brewPrefix := "/usr/local" -}}
{{- if eq .chezmoi.arch "arm64" }}{{ $brewPrefix = "/opt/homebrew" }}{{ end }}

[user]
  name = {{ .name | quote }}
  email = {{ .personal_email | quote }}
{{- if .personal_gpg_key }}
  signingkey = {{ .personal_gpg_key }}
{{- end }}

{{- if .personal_gpg_key }}

[commit]
  gpgsign = true

[tag]
  gpgsign = true

{{- if eq .chezmoi.os "darwin" }}

[gpg]
  program = {{ $brewPrefix }}/bin/gpg
{{- end }}
{{- end }}
