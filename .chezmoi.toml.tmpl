{{- $name := promptStringOnce . "name" "Full name (for git commits)" -}}
{{- $email := promptStringOnce . "email" "Work email" (printf "%s@talieisin.co.uk" .chezmoi.username) -}}
{{- $personalEmail := promptStringOnce . "personal_email" "Personal email (for personal projects)" -}}
{{- $editor := promptStringOnce . "editor" "Preferred editor (nano/vim/nvim/code)" "nano" -}}
{{- $workGpgKey := promptStringOnce . "work_gpg_key" "Work GPG signing key ID (empty for no signing)" "" -}}
{{- $personalGpgKey := promptStringOnce . "personal_gpg_key" "Personal GPG signing key ID (empty for no signing)" "" -}}
{{- $gcloudProject := promptStringOnce . "gcloud_project" "Google Cloud project for GenAI/Vertex (empty to skip)" "" -}}
{{- $gcloudLocation := promptStringOnce . "gcloud_location" "Google Cloud location" "europe-west2" }}
# Chezmoi Configuration
# Rendered to ~/.config/chezmoi/chezmoi.toml on `chezmoi init`.
# Prompts fire once (answers persist in the rendered config); re-run
# `chezmoi init` to re-render after editing this template.

[data]
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  personal_email = {{ $personalEmail | quote }}
  editor = {{ $editor | quote }}
  work_gpg_key = {{ $workGpgKey | quote }}
  personal_gpg_key = {{ $personalGpgKey | quote }}
  gcloud_project = {{ $gcloudProject | quote }}
  gcloud_location = {{ $gcloudLocation | quote }}

  # Git identity routing (consumed by dot_gitconfig.tmpl). Directories in
  # neither list get NO identity — git fails loudly rather than mis-attributing.
  # Extend these in your fork to match your directory layout.
  work_dirs = [
    "~/work/",
    "~/src/work/",
    "~/Projects/Talieisin/",
    "~/Projects/work/",
  ]
  personal_dirs = [
    "~/personal/",
    "~/src/personal/",
    "~/Projects/personal/",
  ]
