# Talieisin Developer Zsh Configuration
# This is a chezmoi template - customize to your preferences
#
# Ordering matters:
#   brew shellenv → PATH additions → options/completions → aliases/env →
#   secrets/local hooks → mise activate → prompt → plugins
#   (zsh-syntax-highlighting must stay literally last).

{{- $brewPrefix := "/usr/local" -}}
{{- if eq .chezmoi.arch "arm64" }}{{ $brewPrefix = "/opt/homebrew" }}{{ end }}

# ============================================================================
# HOMEBREW (must come first — everything below may live in its prefix)
# ============================================================================

{{ if eq .chezmoi.os "darwin" -}}
eval "$({{ $brewPrefix }}/bin/brew shellenv)"
{{- end }}

# ============================================================================
# PATH ADDITIONS & TOOL HOMES
# ============================================================================

{{ if eq .chezmoi.os "darwin" -}}
# OrbStack - Docker & Linux VMs
export PATH="$HOME/.orbstack/bin:$PATH"
{{- end }}

# pipx / uv tools
export PATH="$PATH:$HOME/.local/bin"

# Go binaries
export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH/bin"

# ============================================================================
# SHELL OPTIONS
# ============================================================================

setopt AUTO_CD              # cd by typing directory name
setopt INTERACTIVE_COMMENTS # Allow comments in interactive shell
setopt HIST_IGNORE_DUPS     # Don't record duplicates in history
setopt SHARE_HISTORY        # Share history between sessions

# History
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history

# ============================================================================
# COMPLETION SYSTEM (cached dump, skip audit on subsequent loads)
# ============================================================================

fpath=("$HOME/.zsh/completions" $fpath)
mkdir -p "$HOME/.cache/zsh"
autoload -Uz compinit
if [ -f "$HOME/.cache/zsh/zcompdump" ]; then
  compinit -C -d "$HOME/.cache/zsh/zcompdump"   # cache exists: skip audit
else
  compinit -d "$HOME/.cache/zsh/zcompdump"      # first run: full audit
fi

# Case-insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Bash-style completions (aws)
autoload bashcompinit && bashcompinit

# Tool completions (guarded — only when the tool is installed)
command -v kubectl &> /dev/null && source <(kubectl completion zsh)
command -v helm &> /dev/null && source <(helm completion zsh)
command -v ionosctl &> /dev/null && source <(ionosctl completion zsh)
{{ if eq .chezmoi.os "darwin" -}}
[ -x "{{ $brewPrefix }}/bin/aws_completer" ] && complete -C '{{ $brewPrefix }}/bin/aws_completer' aws
{{- end }}

# ============================================================================
# ALIASES (customize to your preference)
# ============================================================================

# Modern CLI replacements (if installed)
if command -v eza &> /dev/null; then
  alias ls="eza"
  alias ll="eza -la"
  alias tree="eza --tree"
fi

if command -v bat &> /dev/null; then
  alias cat="bat"
fi

# rg is available directly; aliasing grep→rg changes flag semantics, so it is
# deliberately NOT aliased. Uncomment if you prefer it:
# command -v rg &> /dev/null && alias grep="rg"

# Git shortcuts
alias g="git"
alias gs="git status"
alias gd="git diff"
alias gc="git commit"
alias gp="git push"
alias gl="git log --oneline --graph"

# Docker/OrbStack
alias d="docker"
alias dc="docker compose"
alias k="kubectl"

# Chezmoi shortcuts
alias cz="chezmoi"
alias cze="chezmoi edit"
alias cza="chezmoi apply"
alias czd="chezmoi diff"

# ============================================================================
# FUNCTIONS
# ============================================================================

# Quick directory navigation
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Git clone and cd
gcl() {
  git clone "$1" && cd "$(basename "${1%/}" .git)"
}

# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================

# Editor
{{- if eq .editor "code" }}
export EDITOR="code --wait"
export VISUAL="code --wait"
{{- else if .editor }}
export EDITOR="{{ .editor }}"
export VISUAL="{{ .editor }}"
{{- else }}
export EDITOR="nano"
export VISUAL="nano"
{{- end }}

# Less options
export LESS="-R -F -X"

# Colorized man pages
export MANPAGER="less -R --use-color -Dd+r -Du+b"

{{- if .gcloud_project }}

# Google GenAI via Vertex (non-secret, machine-parameterised via chezmoi data)
export GOOGLE_GENAI_USE_VERTEXAI=true
export GOOGLE_CLOUD_PROJECT={{ .gcloud_project | quote }}
export GOOGLE_CLOUD_LOCATION={{ .gcloud_location | quote }}
{{- end }}

{{ if and (eq .chezmoi.os "darwin") (default false (get . "ionos_token_export")) -}}
# IONOS Token - derived from ionosctl config at runtime (opt-in via the
# ionos_token_export data flag; never stored in this file)
if [ -f "$HOME/Library/Application Support/ionosctl/config.yaml" ]; then
    export IONOS_TOKEN=$(awk -F': *' '/^token:/ {gsub(/"/, "", $2); print $2; exit}' "$HOME/Library/Application Support/ionosctl/config.yaml")
fi
{{- end }}

# ============================================================================
# SECRETS (optional — point your secret store's output here; never commit
# plaintext secrets to any dotfiles repo)
# ============================================================================

[ -f ~/.config/zsh/secrets.zsh ] && source ~/.config/zsh/secrets.zsh

# ============================================================================
# OPTIONAL: Load company-wide aliases (if provided)
# ============================================================================

[ -f ~/.talieisin_aliases ] && source ~/.talieisin_aliases

# ============================================================================
# OPTIONAL: Load machine-specific config
# ============================================================================

[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# ============================================================================
# RUNTIME MANAGER (mise) — late so nothing above shadows its PATH entries
# ============================================================================

if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

# ============================================================================
# INTERACTIVE TOOLING (if installed)
# ============================================================================

command -v fzf &> /dev/null && source <(fzf --zsh)
command -v zoxide &> /dev/null && eval "$(zoxide init zsh)"
command -v direnv &> /dev/null && eval "$(direnv hook zsh)"

# ============================================================================
# PROMPT (before plugins — zsh-syntax-highlighting must stay literally last)
# ============================================================================

if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
else
  PROMPT='%F{cyan}%~%f %F{green}❯%f '
fi

# ============================================================================
# ZSH PLUGINS (syntax-highlighting sourced LAST per its INSTALL.md)
# ============================================================================

{{ if eq .chezmoi.os "darwin" -}}
if [ -f "{{ $brewPrefix }}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
  source "{{ $brewPrefix }}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

if [ -f "{{ $brewPrefix }}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
  source "{{ $brewPrefix }}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
{{- end }}
